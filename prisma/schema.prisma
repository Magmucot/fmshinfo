generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// График дежурств классов — онлайн не публикуется (см. docs/sunc-info-analysis.md, разд. 3.4),
// вводится администратором через POST /api/duty (заголовок X-Admin-Key)
model DutyEntry {
  id           Int      @id @default(autoincrement())
  date         String // ДД.ММ.ГГГГ
  dutyType     String   @default("столовая") // столовая | корпус | общежитие | медпункт | прочее
  className    String? // например «10-2»
  responsible  String? // ФИО ответственного воспитателя
  timeInterval String? // например «после 3 урока»
  notes        String?
  createdAt    DateTime @default(now())
}

// Ночные вожатые (воспитатели) по общежитиям — ручной ввод (разд. 3.5)
model NightCounselor {
  id            Int      @id @default(autoincrement())
  date          String // ДД.ММ.ГГГГ
  dormitory     String // Общежитие №1 | Общежитие №2
  counselorName String
  phone         String?
  floor         String? // например «2–3 этажи»
  notes         String?
  createdAt     DateTime @default(now())
}

// Обратная связь с сайта
model Feedback {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String
  message   String
  createdAt DateTime @default(now())
}

// Пользователи Telegram-бота: учёт, сопоставление ID, username (@юзу), класса, подгруппы и активности
model TelegramUser {
  id           String   @id // Telegram user ID в виде строки (защита от переполнения 64-bit int)
  username     String?  // @username («юзу»)
  firstName    String?  // Имя в Telegram
  lastName     String?  // Фамилия в Telegram
  className    String?  // Выбранный класс («10-4», «11-1» и др.)
  subgroup     Int?     // Выбранная подгруппа по основным предметам (1 или 2)
  englishGroup String?  // Выбранная группа по английскому языку («Бариленко И.А.», «Группа I» и др.)
  languageCode String?  // Код языка («ru»)
  isPremium    Boolean  @default(false) // Наличие Telegram Premium
  actionsCount Int      @default(1) // Количество взаимодействий с ботом
  lastAction   String?  // Последняя команда/действие («/schedule», «canteen:class:10-4»)
  firstSeenAt  DateTime @default(now()) // Первое обращение
  lastActiveAt DateTime @default(now()) // Последняя активность
  updatedAt    DateTime @updatedAt

  @@index([className])
  @@index([subgroup])
  @@index([username])
  @@index([lastActiveAt])
}

// Учёт веб-посетителей и популярности классов на сайте
model WebVisitor {
  id           String   @id // Client UUID (localStorage / куки)
  className    String?  // Выбранный класс на портале
  subgroup     Int?     // Выбранная подгруппа на портале (1 или 2)
  userAgent    String?  // Браузер и платформа
  visitsCount  Int      @default(1) // Количество сессий
  lastPath     String?  // Последний посещённый раздел
  firstSeenAt  DateTime @default(now())
  lastActiveAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([className])
  @@index([subgroup])
}

