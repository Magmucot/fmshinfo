[Unit]
Description=SUNC Info Telegram bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=sunc-bot
Group=sunc-bot
WorkingDirectory=/opt/sunc-info/mini-services/tg-bot
EnvironmentFile=/etc/sunc-tg-bot.env
ExecStart=/opt/sunc-info/mini-services/tg-bot/run-production.sh
Restart=always
RestartSec=10
TimeoutStopSec=30
StateDirectory=sunc-tg-bot
StateDirectoryMode=0700
LogsDirectory=sunc-tg-bot
LogsDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sunc-tg-bot

[Install]
WantedBy=multi-user.target
