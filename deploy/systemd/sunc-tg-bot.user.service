[Unit]
Description=SUNC Info Telegram bot (user service)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/fmshinfo/mini-services/tg-bot
EnvironmentFile=%h/.config/sunc-tg-bot.env
ExecStart=%h/fmshinfo/mini-services/tg-bot/run-production.sh
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sunc-tg-bot

[Install]
WantedBy=default.target
